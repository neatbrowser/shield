<Page
    x:Class="NeatShield.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NeatShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="24" MaxWidth="820" HorizontalAlignment="Center">

            <InfoBar x:Name="Banner" IsOpen="False" IsClosable="False" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="BannerButton" loc:L.Key="home.cert.button" Click="BannerButton_Click" Visibility="Collapsed" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel HorizontalAlignment="Center" Spacing="12" Padding="0,16,0,0">
                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                    <Ellipse x:Name="Disc" Fill="#009670" />
                    <FontIcon x:Name="ShieldGlyph" Glyph="&#xEA18;" FontSize="64" Foreground="White" />
                    <ProgressRing x:Name="Busy" IsActive="False" Width="140" Height="140" Foreground="White" />
                </Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Text="" />
                <TextBlock x:Name="SubText" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="Toggle" HorizontalAlignment="Center" Toggled="Toggle_Toggled" />
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock loc:L.Key="home.blocked.run" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BlockedText" Style="{StaticResource TitleLargeTextBlockStyle}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock loc:L.Key="home.blocked.total" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource TitleLargeTextBlockStyle}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock loc:L.Key="home.pages" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PagesText" Style="{StaticResource TitleLargeTextBlockStyle}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock loc:L.Key="home.requests" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RequestsText" Style="{StaticResource TitleLargeTextBlockStyle}" Text="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TestButton" loc:L.Key="home.test" Click="TestButton_Click" />
                    <ProgressRing x:Name="TestBusy" IsActive="False" Width="20" Height="20" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" loc:L.Key="home.test.hint" />
                <TextBlock x:Name="TestSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TestLines" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
