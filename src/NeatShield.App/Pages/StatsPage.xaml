<Page
    x:Class="NeatShield.App.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NeatShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="stats.title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock loc:L.Key="stats.top" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="TopList" SelectionMode="None" MaxHeight="320" />

            <TextBlock loc:L.Key="stats.recent" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="RecentList" SelectionMode="None" MaxHeight="360" />
        </StackPanel>
    </ScrollViewer>
</Page>
