<Page
    x:Class="NeatShield.App.Pages.FiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NeatShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="filters.title" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="neat-filters" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock x:Name="RulesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LastCheckText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="UpdateButton" loc:L.Key="filters.update" Style="{StaticResource AccentButtonStyle}" Click="UpdateButton_Click" />
                        <ProgressRing x:Name="Ring" IsActive="False" Width="24" Height="24" />
                        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" loc:L.Key="filters.note" />
        </StackPanel>
    </ScrollViewer>
</Page>
