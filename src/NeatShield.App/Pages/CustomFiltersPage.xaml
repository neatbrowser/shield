<Page
    x:Class="NeatShield.App.Pages.CustomFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NeatShield.App"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="12" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="custom.title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock loc:L.Key="custom.intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock loc:L.Key="custom.examples" Margin="0,8,0,0" />
            <StackPanel Spacing="2">
                <TextBlock loc:L.Key="custom.example1" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" />
                <TextBlock loc:L.Key="custom.example2" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" />
                <TextBlock loc:L.Key="custom.example3" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" />
                <TextBlock loc:L.Key="custom.example4" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True" />
            </StackPanel>

            <TextBox x:Name="Rules" loc:L.Header="custom.box" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" MinHeight="320" IsSpellCheckEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button loc:L.Key="custom.save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock loc:L.Key="custom.try" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
            <TextBlock loc:L.Key="custom.try.hint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="TryUrl" loc:L.Header="custom.try.url" PlaceholderText="https://ads.example.com/banner.js" IsSpellCheckEnabled="False" />
            <TextBox x:Name="TryPage" loc:L.Header="custom.try.page" PlaceholderText="https://news.example.org/" IsSpellCheckEnabled="False" />
            <ComboBox x:Name="TryType" loc:L.Header="custom.try.type" SelectedIndex="0" MinWidth="200">
                <ComboBoxItem Content="script" />
                <ComboBoxItem Content="image" />
                <ComboBoxItem Content="stylesheet" />
                <ComboBoxItem Content="xmlhttprequest" />
                <ComboBoxItem Content="subdocument" />
                <ComboBoxItem Content="document" />
                <ComboBoxItem Content="websocket" />
                <ComboBoxItem Content="other" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button loc:L.Key="custom.try.button" Click="Try_Click" />
                <TextBlock x:Name="TryResult" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
