<Window
    x:Class="NeatShield.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NeatShield.App">

    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem loc:L.Key="nav.home" Tag="home" Icon="Home" />
            <NavigationViewItem loc:L.Key="nav.filters" Tag="filters" Icon="Filter" />
            <NavigationViewItem loc:L.Key="nav.custom" Tag="custom" Icon="Edit" />
            <NavigationViewItem loc:L.Key="nav.stats" Tag="stats" Icon="Calendar" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem loc:L.Key="nav.settings" Tag="settings" Icon="Setting" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" Margin="0" />
    </NavigationView>
</Window>
