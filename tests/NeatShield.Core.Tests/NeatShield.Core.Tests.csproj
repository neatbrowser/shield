<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NeatShield.Core\NeatShield.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's texts (plain C#, no WinUI types) are tested here too. -->
    <Compile Include="..\..\src\NeatShield.App\Loc.cs" Link="Loc.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="data\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
